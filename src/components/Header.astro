---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/paises", label: "Países" },
  { href: "/datos", label: "Datos abiertos" },
  { href: "/guia", label: "Cómo pedir" },
  { href: "/plantilla", label: "Plantilla" },
];
function current(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 border-b-4 border-terra bg-ink text-white">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
    <a href="/" class="shrink-0 leading-none">
      <span class="text-[1.45rem] font-semibold tracking-tight">dame<span class="text-terra">mi</span></span>
      <span class="ml-1 text-sm font-medium text-white/70">.info</span>
    </a>
    <nav class="ml-4 hidden items-center gap-1 text-sm font-semibold md:flex" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current(link.href) ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-1.5",
              current(link.href) ? "bg-white/15 text-white" : "text-white/90 hover:bg-white/10 hover:text-white",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <form action="/buscar" method="get" role="search" class="relative ml-auto hidden w-64 lg:block" data-search-root>
      <label class="sr-only" for="q-header">Buscar en el directorio</label>
      <input
        id="q-header"
        name="q"
        data-search-input
        autocomplete="off"
        placeholder="Buscar país, ley o portal"
        class="w-full rounded-md border border-white/25 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/75"
      />
      <div data-search-panel hidden class="absolute left-0 right-0 top-[calc(100%+0.35rem)] z-50 overflow-hidden rounded-md border border-line bg-card text-ink shadow-lg"></div>
    </form>
    <details class="relative ml-auto md:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-white/25 px-3 py-2 text-sm font-semibold text-white">Menú</summary>
      <nav class="absolute right-0 z-50 mt-2 w-56 rounded-md border border-line bg-card p-3 text-ink shadow-lg" aria-label="Móvil">
        {
          links.map((link) => (
            <a class="block rounded-md px-2 py-2 font-semibold hover:bg-paper" href={link.href}>
              {link.label}
            </a>
          ))
        }
        <a class="block rounded-md px-2 py-2 font-semibold hover:bg-paper" href="/acerca">Acerca de</a>
      </nav>
    </details>
  </div>
  <form action="/buscar" method="get" role="search" class="relative mx-auto max-w-6xl px-4 pb-3 lg:hidden" data-search-root>
    <label class="sr-only" for="q-mobile">Buscar en el directorio</label>
    <input
      id="q-mobile"
      name="q"
      data-search-input
      autocomplete="off"
      placeholder="Buscar país, ley, portal o tema"
      class="w-full rounded-md border border-white/25 bg-white/10 px-3 py-2 text-base text-white placeholder:text-white/75"
    />
    <div data-search-panel hidden class="absolute left-4 right-4 top-[calc(100%-0.35rem)] z-50 overflow-hidden rounded-md border border-line bg-card text-ink shadow-lg"></div>
  </form>
</header>
