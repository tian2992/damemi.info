---
import Layout from "../layouts/Layout.astro";
import { allResources, placeName } from "../data/catalog";
import { countries } from "../data/countries";
import { kindLabel, topicLabel } from "../data/labels";
import { resourceKinds, topics } from "../data/types";

const resources = allResources().sort((a, b) => a.name.localeCompare(b.name, "es"));
const places = [
  ...countries.map((country) => ({ id: country.slug, label: country.name })),
  { id: "regional", label: "Regional e internacional" },
];
---

<Layout
  title="Datos abiertos"
  description="Catálogo de portales de datos abiertos, compras públicas, estadística y canales de solicitud en América Latina y el Caribe."
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">Catálogo</p>
    <h1 class="mt-2 max-w-3xl font-serif text-4xl tracking-tight sm:text-5xl">Datos que ya están publicados</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Portales oficiales, sistemas de compras, institutos de estadística y las ventanillas donde se presenta una solicitud. Si el archivo está aquí, no hace falta pedirlo.
    </p>

    <form class="no-print mt-8 rounded-md border border-line bg-card p-4" aria-label="Filtrar recursos">
      <div class="grid gap-3 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <label class="text-xs font-semibold uppercase tracking-wider text-muted" for="catalogo-q">Texto</label>
          <input id="catalogo-q" data-catalog-query class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2" type="search" placeholder="INEGI, compras, presupuesto…" />
        </div>
        <div>
          <label class="text-xs font-semibold uppercase tracking-wider text-muted" for="catalogo-pais">País</label>
          <select id="catalogo-pais" data-catalog-country class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2">
            <option value="">Todos</option>
            {places.map((place) => <option value={place.id}>{place.label}</option>)}
          </select>
        </div>
        <div>
          <label class="text-xs font-semibold uppercase tracking-wider text-muted" for="catalogo-tipo">Tipo</label>
          <select id="catalogo-tipo" data-catalog-kind class="mt-1 w-full rounded-md border border-line bg-paper px-3 py-2">
            <option value="">Todos</option>
            {resourceKinds.map((kind) => <option value={kind.id}>{kind.label}</option>)}
          </select>
        </div>
      </div>
      <fieldset class="mt-4">
        <legend class="text-xs font-semibold uppercase tracking-wider text-muted">Temas</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            topics.map((topic) => (
              <label class="topic-chip cursor-pointer rounded-full border border-line bg-paper px-3 py-1 text-sm">
                <input class="sr-only" type="checkbox" value={topic.id} data-topic-filter />
                {topic.label}
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="mt-4 flex items-center justify-between gap-3 text-sm">
        <p><span data-catalog-count>{resources.length}</span> recursos</p>
        <button class="font-semibold text-teal" type="button" data-catalog-reset>Limpiar filtros</button>
      </div>
      <noscript>
        <p class="mt-3 text-sm text-muted">Sin JavaScript ves el catálogo completo. Los filtros necesitan el navegador.</p>
      </noscript>
    </form>

    <p hidden data-catalog-empty class="mt-8 rounded-md border border-dashed border-line bg-card px-4 py-8 text-center text-ink-soft">
      Ningún recurso coincide con ese filtro. Prueba con otro país o limpia los filtros.
    </p>

    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {
        resources.map((resource) => (
          <li
            id={resource.id}
            data-resource
            data-country={resource.countryId}
            data-kind={resource.kind}
            data-topics={resource.topics.join(",")}
            data-blob={`${resource.name} ${resource.description} ${resource.publisher} ${placeName(resource.countryId)}`}
            class="rail-side scroll-mt-28 rounded-lg border border-line bg-card p-4 shadow-sm"
          >
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">
              {placeName(resource.countryId)} · {kindLabel(resource.kind)}
            </p>
            <a class="mt-1 block text-xl font-semibold leading-tight text-ink underline decoration-line underline-offset-4 hover:decoration-terra" href={resource.url}>
              {resource.name}
            </a>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{resource.description}</p>
            <p class="mt-3 text-xs text-muted">
              {resource.publisher}
              {" · "}
              {resource.topics.map((topic) => topicLabel(topic)).join(" · ")}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
  <script>
    import { initCatalog } from "../scripts/catalog";
    initCatalog();
  </script>
</Layout>
