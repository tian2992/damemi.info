---
import Layout from "../../layouts/Layout.astro";
import { countries } from "../../data/countries";
import { regions } from "../../data/types";
import { lawStatusLabel } from "../../data/labels";
---

<Layout
  title="Países"
  description="Plazos, leyes y portales para solicitar información pública en América Latina y el Caribe."
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">Directorio</p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight sm:text-5xl">Países y plazos</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Cada ficha dice quién debe responder, en cuántos días, dónde se presenta la solicitud y qué datos ya están publicados. Si no hay ley útil, la ficha lo dice.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      {
        regions.map((region) => (
          <a class="rounded-full border border-line bg-card px-3 py-1 text-sm font-semibold text-ink-soft hover:border-ink" href={`#${region.id}`}>
            {region.label}
          </a>
        ))
      }
    </div>

    <div class="mt-8 space-y-10">
      {
        regions.map((region) => {
          const group = countries.filter((country) => country.region === region.id);
          return (
            <section id={region.id} class="scroll-mt-28">
              <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-muted">{region.label}</h2>
              <div class="mt-3 overflow-x-auto">
                <table class="w-full min-w-[640px] border-collapse text-left text-sm">
                  <caption class="sr-only">Plazos en {region.label}</caption>
                  <thead class="border-b border-ink text-xs uppercase tracking-wider text-muted">
                    <tr>
                      <th class="py-2 pr-4 font-semibold" scope="col">País</th>
                      <th class="py-2 pr-4 font-semibold" scope="col">Marco</th>
                      <th class="py-2 pr-4 font-semibold" scope="col">Plazo</th>
                      <th class="py-2 font-semibold" scope="col">Dónde se pide</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.map((country) => (
                      <tr class="border-b border-line align-top">
                        <th class="py-3 pr-4 font-serif text-xl font-medium" scope="row">
                          <a class="hover:text-terra-deep" href={`/paises/${country.slug}`}>{country.name}</a>
                        </th>
                        <td class="py-3 pr-4">{lawStatusLabel(country.lawStatus)}</td>
                        <td class="py-3 pr-4 font-semibold">{country.deadlineShort}</td>
                        <td class="py-3 text-ink-soft">{country.requestPortalName}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</Layout>
