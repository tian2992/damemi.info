---
import Layout from "../layouts/Layout.astro";
import { countries } from "../data/countries";
import { safeJson } from "../lib/json";

const payload = countries.map((country) => ({
  slug: country.slug,
  name: country.name,
  letterBasis: country.letterBasis,
  letterWarning: country.letterWarning,
  deadlineShort: country.deadlineShort,
  requestPortalName: country.requestPortalName,
  requestPortalUrl: country.requestPortalUrl,
  requestLanguage: country.requestLanguage,
}));

const generic = `Ciudad, fecha

[Autoridad]

Asunto: solicitud de acceso a la información pública

[Nombre], con medio de notificación en [contacto], solicito acceso a la siguiente información:

[Describe documentos o registros existentes, el periodo y el formato.]

No estoy obligado(a) a explicar el motivo. Agradezco el acuse de recibo.

Atentamente,
[Nombre]`;
---

<Layout
  title="Plantilla de solicitud"
  description="Arma una carta de acceso a la información pública con la ley del país. Se redacta en tu navegador y no se guarda en un servidor."
>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gold">Plantilla</p>
    <h1 class="mt-2 max-w-3xl font-serif text-4xl tracking-tight sm:text-5xl">Cartas para pedir información con la ley de tú país</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Llená el formulario. La carta cita la norma de la ficha y, si el trámite es en inglés, francés o portugués, sale en ese idioma. 
    </p>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      <strong>Nada de lo que escribes sale de esta página y todo se procesa localmente en tu navegador.</strong> Copiala, imprimila o mandala por correo electrónico.

      Si no te gusta el fraseo o te interesa aportar una plantilla, <a class='font-semibold text-teal' href='acerca'>contáctanos</a> y colabora <a class="font-semibold text-teal" href="">en el catálogo</a>
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <form id="carta-form" class="space-y-4">
        <div>
          <label class="text-sm font-semibold" for="pais">País</label>
          <select id="pais" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2">
            {countries.map((country) => <option value={country.slug}>{country.name}</option>)}
          </select>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="text-sm font-semibold" for="lugar">Ciudad</label>
            <input id="lugar" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2" autocomplete="address-level2" />
          </div>
          <div>
            <label class="text-sm font-semibold" for="nombre">Tu nombre</label>
            <input id="nombre" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2" autocomplete="name" />
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="text-sm font-semibold" for="identificacion">Identificación, si la piden</label>
            <input id="identificacion" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2" />
          </div>
          <div>
            <label class="text-sm font-semibold" for="contacto">Correo o domicilio para notificaciones</label>
            <input id="contacto" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2" autocomplete="email" />
          </div>
        </div>
        <div>
          <label class="text-sm font-semibold" for="autoridad">Autoridad que tiene la información</label>
          <input id="autoridad" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2" placeholder="Ministerio, municipio, organismo" />
        </div>
        <div>
          <label class="text-sm font-semibold" for="descripcion">Qué documentos pides</label>
          <textarea id="descripcion" class="mt-1 min-h-32 w-full rounded-md border border-line bg-card px-3 py-2" placeholder="Contratos de obra vial de 2024, con anexos y montos, en hoja de cálculo si existen así."></textarea>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="text-sm font-semibold" for="periodo">Periodo</label>
            <input id="periodo" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2" placeholder="1 de enero a 31 de diciembre de 2024" />
          </div>
          <div>
            <label class="text-sm font-semibold" for="medio">Cómo quieres recibirla</label>
            <select id="medio" class="mt-1 w-full rounded-md border border-line bg-card px-3 py-2">
              <option value="email">Correo electrónico, en formato abierto</option>
              <option value="link">Enlace de descarga</option>
              <option value="excelzip">Archivo ZIP de hojas de calculo</option>
              <option value="pdf">Copia digital en PDF con texto seleccionable</option>
              <option value="office">Consulta en la oficina, con posibilidad de copia</option>
            </select>
          </div>
        </div>
      </form>

      <div>
        <p id="carta-aviso" hidden class="mb-3 rounded-md border border-terra/40 bg-note px-3 py-2 text-sm leading-relaxed text-ink"></p>
        <label class="text-sm font-semibold" for="carta">Carta (¡es editable!)</label>
        <textarea id="carta" readonly class="letter-sheet mt-1 min-h-[460px] w-full rounded-md border border-line bg-white px-4 py-4 font-sans text-[1.02rem] leading-relaxed text-ink">{generic}</textarea>
        <div class="no-print mt-3 flex flex-wrap gap-2">
          <button id="copiar" class="rounded-md bg-terra px-4 py-2 text-sm font-semibold text-white hover:bg-terra-deep" type="button">Copiar carta</button>
          <!-- <button id="imprimir" class="rounded-md border border-ink px-4 py-2 text-sm font-semibold hover:bg-paper-deep" type="button">Imprimir</button>  --> 
        </div>
        <p id="carta-meta" class="mt-3 text-sm leading-relaxed text-muted"></p>
        <noscript>
          <p class="mt-3 text-sm text-muted">
            Sin JavaScript queda el modelo de arriba. Elige el país en el directorio, copia la base legal de su ficha y pégala en la carta.
          </p>
        </noscript>
      </div>
    </div>
  </div>
  <script type="application/json" id="plantilla-data" set:html={safeJson(payload)} />
  <script>
    import { initLetter } from "../scripts/letter";
    initLetter();
  </script>
</Layout>
